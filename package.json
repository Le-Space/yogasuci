{
	"name": "yogasuci",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-share-links.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest --run",
		"test:e2e": "playwright test",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"bench": "vite-node bench/run.js",
		"build:handbook": "pnpm --dir docs-site install && pnpm --dir docs-site build && rm -rf build/handbuch && cp -r docs-site/build build/handbuch",
		"screenshots": "SCREENSHOT_LOCALE=de-DE playwright test --project=screenshots && SCREENSHOT_LOCALE=en-GB playwright test --project=screenshots"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@inlang/paraglide-js": "^2.23.0",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/vite": "^4.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"playwright": "1.61.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.0.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^3.2.3"
	},
	"pnpm": {
		"overrides": {
			"@le-space/orbitdb-identity-provider-webauthn-did": "0.5.1"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@chainsafe/libp2p-noise": "^17.0.0",
		"@chainsafe/libp2p-yamux": "^8.0.1",
		"@helia/bitswap": "^4.0.6",
		"@helia/libp2p": "^1.0.6",
		"@ipld/dag-cbor": "^10.0.1",
		"@le-space/libp2p-webrtc-qr": "^0.8.0",
		"@le-space/orbitdb-identity-provider-webauthn-did": "^0.5.1",
		"@libp2p/bootstrap": "^12.0.29",
		"@libp2p/circuit-relay-v2": "^4.2.11",
		"@libp2p/crypto": "^5.1.21",
		"@libp2p/dcutr": "^3.0.27",
		"@libp2p/gossipsub": "^16.1.0",
		"@libp2p/identify": "^4.1.10",
		"@libp2p/peer-id": "^6.0.13",
		"@libp2p/pubsub-peer-discovery": "^12.0.0",
		"@libp2p/webrtc": "^6.0.30",
		"@libp2p/websockets": "^10.1.19",
		"@multiformats/multiaddr": "^13.0.3",
		"@noble/hashes": "^2.2.0",
		"@orbitdb/core": "^4.0.0",
		"blockstore-level": "^4.0.1",
		"datastore-level": "^13.0.1",
		"helia": "^7.1.0",
		"jsqr": "^1.4.0",
		"libp2p": "^3.3.6",
		"multiformats": "^14.0.3",
		"qrcode": "^1.5.4",
		"uint8arrays": "^5.1.0",
		"vite-plugin-node-polyfills": "^0.24.0"
	}
}
